<%- include('../partials/head', { title: 'Uredi običaj' }) %>

<div class="admin-layout">

  <%- include('../partials/sidebar') %>

  <div class="admin-main">

    <%- include('../partials/header', { korisnickoIme }) %>

    <main class="admin-content">

      <%- include('../partials/messages') %>

      <div class="mb-4">
        <h1 class="fw-bold mb-2">Uredi običaj</h1>

        <p class="text-muted mb-0">
          Uredite podatke o običaju
          <strong><%= obicaj.naziv %></strong>.
        </p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

          <form
            method="POST"
            action="/admin/obicaji/<%= obicaj.id %>/uredi"
            enctype="multipart/form-data"
          >

            <div class="mb-3">
              <label for="naziv" class="form-label">
                Naziv običaja *
              </label>

              <input
                type="text"
                class="form-control"
                id="naziv"
                name="naziv"
                value="<%= obicaj.naziv || '' %>"
                required
                maxlength="150"
              >
            </div>

            <div class="mb-3">
              <label for="kratki_opis" class="form-label">
                Kratki opis *
              </label>

              <textarea
                class="form-control"
                id="kratki_opis"
                name="kratki_opis"
                rows="3"
                required
                maxlength="300"
              ><%= obicaj.kratki_opis || '' %></textarea>

              <div class="form-text">
                Prikazuje se na karticama običaja.
              </div>
            </div>

            <div class="mb-3">
              <label for="detaljni_opis" class="form-label">
                Detaljni opis *
              </label>

              <textarea
                class="form-control"
                id="detaljni_opis"
                name="detaljni_opis"
                rows="7"
                required
              ><%= obicaj.detaljni_opis || '' %></textarea>
            </div>

            <div class="mb-3">
              <label for="povijest" class="form-label">
                Povijest
              </label>

              <textarea
                class="form-control"
                id="povijest"
                name="povijest"
                rows="6"
              ><%= obicaj.povijest || '' %></textarea>
            </div>

            <div class="row">

              <div class="col-md-6 mb-3">
                <label for="mjesto" class="form-label">
                  Mjesto
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="mjesto"
                  name="mjesto"
                  value="<%= obicaj.mjesto || '' %>"
                  maxlength="150"
                >
              </div>

              <div class="col-md-6 mb-3">
                <label for="organizator" class="form-label">
                  Organizator
                </label>

                <input
                  type="text"
                  class="form-control"
                  id="organizator"
                  name="organizator"
                  value="<%= obicaj.organizator || '' %>"
                  maxlength="150"
                >
              </div>

            </div>

            <div class="mb-3">
              <label for="naslovna_slika" class="form-label">
                Nova naslovna slika
              </label>

              <% if (obicaj.naslovna_slika) { %>
                <div class="mb-3">

                  <p class="mb-2 text-muted">
                    Trenutačna slika:
                  </p>

                  <img
                    src="/images/<%= obicaj.naslovna_slika %>"
                    alt="<%= obicaj.naziv %>"
                    class="img-fluid rounded admin-image-preview"
                  >

                </div>
              <% } %>

              <input
                type="file"
                class="form-control"
                id="naslovna_slika"
                name="naslovna_slika"
                accept=".jpg,.jpeg,.png,.webp"
              >

              <div class="form-text">
                Ako ne odaberete novu sliku, postojeća slika ostaje spremljena.
                Dopušteni formati su JPG, PNG i WEBP, do 5 MB.
              </div>
            </div>

            <div class="mb-4">
              <label for="status_objave" class="form-label">
                Status
              </label>

              <select
                class="form-select"
                id="status_objave"
                name="status_objave"
              >
                <option
                  value="0"
                  <%= Number(obicaj.status_objave) === 0 ? 'selected' : '' %>
                >
                  Skica
                </option>

                <option
                  value="1"
                  <%= Number(obicaj.status_objave) === 1 ? 'selected' : '' %>
                >
                  Objavljeno
                </option>
              </select>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">

              <button type="submit" class="btn btn-dark">
                Spremi promjene
              </button>

              <a
                href="/admin/obicaji"
                class="btn btn-outline-secondary"
              >
                Odustani
              </a>

            </div>

          </form>

        </div>
      </div>

<%- include('../partials/footer') %>