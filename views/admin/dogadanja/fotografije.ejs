<%- include('../partials/head', { title: 'Fotografije događanja' }) %>

<div class="admin-layout">

  <%- include('../partials/sidebar') %>

  <div class="admin-main">

    <%- include('../partials/header', { korisnickoIme }) %>

    <main class="admin-content">

      <%- include('../partials/messages') %>

      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4"
      >

        <div>

          <h1 class="fw-bold mb-2">
            Fotografije događanja
          </h1>

          <p class="text-muted mb-0">
            <strong><%= dogadanje.naziv %></strong>
          </p>

        </div>

        <a
          href="/admin/dogadanja"
          class="btn btn-outline-secondary mt-3 mt-md-0"
        >
          Natrag na događanja
        </a>

      </div>


      <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

          <h2 class="h5 fw-bold mb-3">
            Dodaj fotografiju
          </h2>

          <form
            method="POST"
            action="/admin/dogadanja/<%= dogadanje.id %>/fotografije"
            enctype="multipart/form-data"
          >

            <div class="mb-3">

              <label
                for="fotografija"
                class="form-label"
              >
                Fotografija
              </label>

              <input
                type="file"
                class="form-control"
                id="fotografija"
                name="fotografija"
                accept=".jpg,.jpeg,.png,.webp"
                required
              >

              <div class="form-text">
                Dopušteni formati su JPG, PNG i WEBP.
                Najveća veličina fotografije je 5 MB.
              </div>

            </div>


            <div class="mb-3">

              <label
                for="opis"
                class="form-label"
              >
                Opis fotografije
              </label>

              <input
                type="text"
                class="form-control"
                id="opis"
                name="opis"
                maxlength="255"
                placeholder="Npr. Sudionici tijekom događanja"
              >

              <div class="form-text">
                Opis nije obavezan.
              </div>

            </div>


            <button
              type="submit"
              class="btn btn-dark"
            >
              Dodaj fotografiju
            </button>

          </form>

        </div>

      </div>


      <% if (fotografije && fotografije.length > 0) { %>

        <div class="row g-4">

          <% fotografije.forEach((fotografija) => { %>

            <div class="col-sm-6 col-md-4 col-xl-3">

              <div class="card h-100 border-0 shadow-sm">

                <img
                  src="/images/<%= fotografija.putanja %>"
                  class="card-img-top"
                  alt="<%= fotografija.opis || dogadanje.naziv %>"
                  style="height: 220px; object-fit: cover;"
                >

                <div class="card-body d-flex flex-column">

                  <% if (fotografija.opis) { %>

                    <p class="card-text text-muted mb-3">
                      <%= fotografija.opis %>
                    </p>

                  <% } else { %>

                    <p class="card-text text-muted mb-3">
                      Bez opisa.
                    </p>

                  <% } %>


                  <form
                    method="POST"
                    action="/admin/dogadanja/<%= dogadanje.id %>/fotografije/<%= fotografija.id %>/obrisi"
                    class="mt-auto"
                    onsubmit="return confirm('Želite li obrisati ovu fotografiju?');"
                  >

                    <button
                      type="submit"
                      class="btn btn-outline-danger btn-sm w-100"
                    >
                      Obriši
                    </button>

                  </form>

                </div>

              </div>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="alert alert-info">
          Ovo događanje još nema dodatnih fotografija.
        </div>

      <% } %>

    </main>

  </div>

</div>

<%- include('../partials/footer') %>