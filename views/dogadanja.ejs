<%- include('partials/head', { title: 'Događanja' }) %>

<%- include('partials/navbar') %>

<main>

  <section class="events-hero py-5">
    <div class="container text-center">

      <h1 class="fw-bold mb-3">
        Kalendar događanja
      </h1>

      <p class="lead mx-auto mb-0" style="max-width: 760px;">
        Pregledajte nadolazeća održavanja puntarskih običaja
        i arhivu prethodnih događanja.
      </p>

    </div>
  </section>

  <section class="container py-5">

    <div class="mb-5">

      <h2 class="fw-bold mb-4">
        Nadolazeća događanja
      </h2>

      <% if (buducaDogadanja.length > 0) { %>

        <div class="row g-4">

          <% buducaDogadanja.forEach(dogadanje => { %>

            <% const datumPocetka = new Date(dogadanje.datum_pocetka); %>

            <div class="col-md-6 col-xl-4">

              <article class="card event-card h-100">

                <div class="card-body d-flex flex-column p-4">

                  <div class="event-date-box mb-3">

                    <span class="event-day">
                      <%= datumPocetka.toLocaleDateString('hr-HR', {
                        day: '2-digit'
                      }) %>
                    </span>

                    <span class="event-month">
                      <%= datumPocetka.toLocaleDateString('hr-HR', {
                        month: 'long'
                      }) %>
                    </span>

                    <span class="event-year">
                      <%= datumPocetka.getFullYear() %>
                    </span>

                  </div>

                  <h3 class="h5">
                    <%= dogadanje.naziv %>
                  </h3>

                  <p class="text-muted mb-2">
                    <strong>Običaj:</strong>
                    <%= dogadanje.naziv_obicaja %>
                  </p>

                  <p class="mb-2">
                    <strong>Vrijeme:</strong>
                    <%= datumPocetka.toLocaleTimeString('hr-HR', {
                      hour: '2-digit',
                      minute: '2-digit'
                    }) %>
                  </p>

                  <p class="mb-3">
                    <strong>Lokacija:</strong>
                    <%= dogadanje.lokacija %>
                  </p>

                  <% if (dogadanje.opis) { %>
                    <p class="card-text">
                      <%= dogadanje.opis %>
                    </p>
                  <% } %>

                  <a
                    href="/obicaji/<%= dogadanje.obicaj_id %>"
                    class="btn btn-dark mt-auto"
                  >
                    Saznaj više o običaju
                  </a>

                </div>

              </article>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="alert alert-info">
          Trenutačno nema objavljenih budućih događanja.
        </div>

      <% } %>

    </div>

    <div>

      <h2 class="fw-bold mb-4">
        Arhiva održavanja
      </h2>

      <% if (proslaDogadanja.length > 0) { %>

        <div class="list-group shadow-sm">

          <% proslaDogadanja.forEach(dogadanje => { %>

            <a
              href="/obicaji/<%= dogadanje.obicaj_id %>"
              class="list-group-item list-group-item-action py-3"
            >

              <div class="d-flex flex-column flex-md-row justify-content-between gap-2">

                <div>

                  <h3 class="h6 mb-1">
                    <%= dogadanje.naziv %>
                  </h3>

                  <p class="mb-0 text-muted">
                    <%= dogadanje.naziv_obicaja %>
                    ·
                    <%= dogadanje.lokacija %>
                  </p>

                </div>

                <span class="text-muted">
                  <%= new Date(dogadanje.datum_pocetka)
                    .toLocaleDateString('hr-HR') %>
                </span>

              </div>

            </a>

          <% }) %>

        </div>

      <% } else { %>

        <p class="text-muted">
          Arhiva prethodnih održavanja još je prazna.
        </p>

      <% } %>

    </div>

  </section>

</main>

<%- include('partials/footer') %>