<%- include('partials/head', { title: 'Početna' }) %>

<%- include('partials/navbar') %>

<header class="hero-section">
  <div class="container">
    <div class="hero-content">
      <h1 class="display-4 fw-bold">
        Nematerijalna kulturna baština Punta
      </h1>

      <p class="lead mt-3">
        Otkrijte običaje, tradicije i događanja koja čuvaju identitet mjesta Punat.
      </p>

      <a href="/obicaji" class="btn btn-light btn-lg mt-3">
        Pregledaj običaje
      </a>
    </div>
  </div>
</header>

<main>
  <section class="container py-5">
    <h2 class="section-title">Istaknuti običaji</h2>

    <div class="row g-4">
      <% if (obicaji && obicaji.length > 0) { %>

        <% obicaji.slice(0, 3).forEach(obicaj => { %>
          <div class="col-md-6 col-lg-4">
            <article class="card custom-card">

              <% if (obicaj.naslovna_slika) { %>
                <img
                  src="/images/<%= obicaj.naslovna_slika %>"
                  class="card-img-top"
                  alt="<%= obicaj.naziv %>"
                >
              <% } %>

              <div class="card-body d-flex flex-column">
                <h3 class="card-title h5">
                  <%= obicaj.naziv %>
                </h3>

                <p class="card-text">
                  <%= obicaj.kratki_opis %>
                </p>

                <a
                  href="/obicaji/<%= obicaj.id %>"
                  class="btn btn-dark mt-auto"
                >
                  Pročitaj više
                </a>
              </div>
            </article>
          </div>
        <% }) %>

      <% } else { %>
        <p class="text-center">
          Trenutačno nema objavljenih običaja.
        </p>
      <% } %>
    </div>
  </section>


  <section class="bg-white py-5">
  <div class="container">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
      <div>
        <h2 class="fw-bold mb-2">Nadolazeća događanja</h2>

        <p class="text-muted mb-0">
          Pogledajte sljedeća održavanja puntarskih običaja.
        </p>
      </div>

      <a
        href="/dogadanja"
        class="btn btn-outline-dark mt-3 mt-md-0"
      >
        Pogledaj sva događanja
      </a>
    </div>

    <% if (dogadanja && dogadanja.length > 0) { %>

      <div class="row g-4">

        <% dogadanja.forEach(dogadanje => { %>

          <% const datum = new Date(dogadanje.datum_pocetka); %>

          <div class="col-md-6 col-lg-4">

            <article class="card event-card h-100">

              <div class="card-body d-flex flex-column p-4">

                <div class="event-date-box mb-3">

                  <span class="event-day">
                    <%= datum.toLocaleDateString('hr-HR', {
                      day: '2-digit'
                    }) %>
                  </span>

                  <span class="event-month">
                    <%= datum.toLocaleDateString('hr-HR', {
                      month: 'long'
                    }) %>
                  </span>

                  <span class="event-year">
                    <%= datum.getFullYear() %>
                  </span>

                </div>

                <h3 class="h5">
                  <%= dogadanje.naziv %>
                </h3>

                <p class="text-muted mb-2">
                  <%= dogadanje.naziv_obicaja %>
                </p>

                <p class="mb-2">
                  <strong>Vrijeme:</strong>
                  <%= datum.toLocaleTimeString('hr-HR', {
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                </p>

                <p class="mb-3">
                  <strong>Lokacija:</strong>
                  <%= dogadanje.lokacija %>
                </p>

                <a
                  href="/obicaji/<%= dogadanje.obicaj_id %>"
                  class="btn btn-dark mt-auto"
                >
                  Saznaj više
                </a>

              </div>

            </article>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <div class="alert alert-info">
        Trenutačno nema objavljenih budućih događanja.
      </div>

    <% } %>

  </div>
</section>

  <section class="bg-white py-5">
    <div class="container text-center">
      <h2>O projektu</h2>

      <p class="mx-auto mt-3" style="max-width: 760px;">
        Projekt je razvijen radi digitalnog očuvanja i prezentacije živih običaja,
        tradicija i događanja mjesta Punat. Aplikacija istodobno služi kao
        digitalni arhiv i kalendar budućih održavanja.
      </p>
    </div>
  </section>
</main>

<%- include('partials/footer') %>